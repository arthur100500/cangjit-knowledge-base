+    do {
+        changed = false;
+        for (const auto b : work) {
+            if (b == entry->second) {
+                continue;
+            }
+            Bits next(blocks.size(), 1);
+            for (const auto pred : predecessors[b]) {
+                if (!reachable[pred]) {
+                    continue;
+                }
+                for (size_t i = 0; i < blocks.size(); ++i) {
+                    next[i] &= dominators[pred][i];
+                }
+            }
+            next[b] = 1;
+            if (next != dominators[b]) {
+                dominators[b] = std::move(next);
+                changed = true;
+            }
+        }
+    } while (changed);
